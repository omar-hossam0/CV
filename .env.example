# ===========================================
# CV/Resume Matching Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env files to version control

# ===========================================
# Database Configuration
# ===========================================
MONGODB_URI=mongodb://localhost:27017/cv_project_db

# ===========================================
# Authentication
# ===========================================
JWT_SECRET=your-secure-random-secret-key-here
JWT_EXPIRES_IN=7d

# ===========================================
# Backend Configuration
# ===========================================
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174

# ===========================================
# ML Service URLs
# ===========================================
MODEL_1_URL=http://localhost:5001
MODEL_2_URL=http://localhost:5002
MODEL_3_URL=http://localhost:5003
MODEL_4_URL=http://localhost:5004

# Legacy variable names (used in backend)
ML_HOST=http://localhost:5001
CV_CLASSIFIER_URL=http://localhost:5002
SKILL_MATCHER_URL=http://localhost:5003
CHAT_MODEL_URL=http://localhost:5004

# ===========================================
# External APIs
# ===========================================
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# ===========================================
# ML Service Configuration
# ===========================================
USE_PYTHON_MATCHER=true

# ===========================================
# Frontend Configuration (Vite)
# ===========================================
# These are set in Frontend/.env
# VITE_API_BASE_URL=http://localhost:5000

# ===========================================
# Debug Options
# ===========================================
# SKIP_AUTH=true
# SKIP_AUTH_ROLE=hr
