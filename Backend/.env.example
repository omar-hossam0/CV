# ===========================================
# Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Database
MONGODB_URI=mongodb://localhost:27017/cv_project_db

# Authentication - IMPORTANT: Generate a secure random secret
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secure-random-secret-key-here

# Server
PORT=5000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5174

# ML Service URLs
# For local development (outside Docker), use localhost:
# ML_HOST=http://localhost:5001
# CV_CLASSIFIER_URL=http://localhost:5002
# SKILL_MATCHER_URL=http://localhost:5003
# CHAT_MODEL_URL=http://localhost:5004
# For Docker Compose development, use service names (set in docker-compose.dev.yml):
ML_HOST=http://model-1:5001
CV_CLASSIFIER_URL=http://model-2:5002
SKILL_MATCHER_URL=http://model-3:5003
CHAT_MODEL_URL=http://model-4:5004

# External APIs
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# ML Service Configuration
USE_PYTHON_MATCHER=true

# Debug Options (for local testing only)
# SKIP_AUTH=true
# SKIP_AUTH_ROLE=hr
# DISABLE_LOGIN=false
