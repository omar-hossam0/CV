# ==============================================================================
# Production Environment Variables (.env)
# 
# Instructions:
# 1. Copy this file to .env on your AWS EC2 server: `cp .env.production.example .env`
# 2. Fill in the values below with your actual production secrets.
# 3. DO NOT commit the .env file to Git repository.
# ==============================================================================

# Database
MONGODB_URI=mongodb://mongodb:27017/cv_project_db
# Or if using MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cv_prod_db?retryWrites=true&w=majority

# Authentication Security (Generate a strong 64-character secret)
JWT_SECRET=replace_with_a_secure_long_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Node Environment
NODE_ENV=production
PORT=5000

# External AI Services
GROQ_API_KEY=gsk_your_groq_api_key_here
