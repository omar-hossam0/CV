{
  "name": "cv-project-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "Backend",
    "Frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend,classifier,analyzer -c blue,magenta,yellow,green --restart-tries 99 --restart-after 3000 --success none \"npm:backend:dev\" \"npm:frontend:dev\" \"npm:classifier:dev\" \"npm:analyzer:dev\"",
    "dev:no-ml": "concurrently -n backend,frontend -c blue,magenta --restart-tries 99 --restart-after 3000 --success none \"npm:backend:dev\" \"npm:frontend:dev\"",
    "dev:web": "concurrently -n backend,frontend -c blue,magenta --restart-tries 99 --restart-after 3000 --success none \"npm:backend:dev\" \"npm:frontend:dev\"",
    "start": "npm run start --workspace Backend",
    "build": "npm run build --workspace Frontend",
    "install:all": "npm install",
    "backend:dev": "npm run dev --workspace Backend",
    "frontend:dev": "npm run dev --workspace Frontend",
    "classifier:dev": "cd model-2-cv-classifier && python cv_classifier.py",
    "analyzer:dev": "cd model-3-skill-analyzer && python skill_analyzer.py"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
